# =============================================================
# Qulaycafe — environment variable reference
# Copy this file to .env and fill in real values.
# .env is excluded from git and Docker images.
# =============================================================

# ----- Server ------------------------------------------------

# Public URL of this server (used to register Telegram webhooks)
APP_URL=https://your-domain.com

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://your-domain.com,https://clients.your-domain.com,https://kitchen.your-domain.com,https://admin.your-domain.com

# Which hostnames serve each surface (comma-separated)
LANDING_HOSTNAMES=your-domain.com,www.your-domain.com
CLIENTS_HOSTNAMES=clients.your-domain.com
LEGACY_APP_HOSTNAMES=app.your-domain.com

# Surface base URLs returned in API responses and Telegram messages
CLIENTS_URL=https://clients.your-domain.com
KITCHEN_URL=https://kitchen.your-domain.com
ADMIN_URL=https://admin.your-domain.com

# Auth
JWT_SECRET=replace-with-a-long-random-secret

# Initial passwords set the first time the database is seeded (dev only).
# In production (NODE_ENV=production) seeding is skipped entirely.
ADMIN_INITIAL_PASSWORD=change-me
KITCHEN_INITIAL_PIN=change-me

# Cookie domain — leave blank to scope cookies to the exact hostname.
# Set to .your-domain.com only if one staff login should span subdomains.
SESSION_COOKIE_DOMAIN=

# ----- Database ----------------------------------------------
# These are used at runtime by db.ts.
# DATABASE_PATH takes precedence; DATABASE_DIR is the fallback directory.
DATABASE_DIR=./data
# DATABASE_PATH is set to the exact file in docker-compose.yml;
# you usually do not need it in .env.
# DATABASE_PATH=/app/data/restaurant.db

ORDER_RETENTION_DAYS=30

# ----- Logging / misc ----------------------------------------
LOG_LEVEL=info
DEFAULT_TRIAL_DAYS=14
ENABLE_SELF_REGISTRATION=false

# Time-zone offset (hours from UTC) for reservation display and restaurant hours
RESERVATION_UTC_OFFSET_HOURS=5
RESTAURANT_UTC_OFFSET_HOURS=5

# ----- Google OAuth ------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ----- Customer-facing Telegram bot --------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ----- Delivery bot ------------------------------------------
TELEGRAM_DELIVERY_BOT_TOKEN=
TELEGRAM_DELIVERY_BOT_USERNAME=
DELIVERY_BOT_WEBHOOK_SECRET=

# ----- Owner / platform bot (Alex's private bot) -------------
OWNER_BOT_TOKEN=
OWNER_TELEGRAM_IDS=123456789
OWNER_BOT_WEBHOOK_SECRET=
OWNER_EXPIRY_REMINDER_DAYS=3
OWNER_CONTACT_PHONE=+998900000000
OWNER_CONTACT_TELEGRAM=your_telegram_handle
OWNER_API_SECRET=

# ----- Vite build-time variables (FRONTEND — inlined by Vite) -----
# These are read at BUILD time by `vite build`, not at runtime.
# They are passed to the Docker build via `build: args:` in compose.
# Do NOT use them for secrets — they end up in the JS bundle.
VITE_CLIENTS_URL=https://clients.your-domain.com
VITE_KITCHEN_URL=https://kitchen.your-domain.com
VITE_ADMIN_URL=https://admin.your-domain.com
VITE_CONTACT_TELEGRAM=your_telegram_handle
VITE_CONTACT_PHONE=+998900000000

# Optional: exact-hostname overrides for non-standard deployments
# (e.g. staging boxes, ngrok tunnels). Leave blank if unused.
VITE_ADMIN_HOSTS=
VITE_KITCHEN_HOSTS=
VITE_CLIENTS_HOSTS=
VITE_LANDING_HOSTS=
VITE_ALLOW_SURFACE_OVERRIDE=
