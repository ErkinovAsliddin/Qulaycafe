# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints —
# above all, this is the origin the Telegram webhooks are registered against,
# so it must be the public https:// origin that actually reaches this server.
# On a self-hosted deploy (Hostinger/AWS), set this to your real domain,
# e.g. https://qulaycafe.uz
APP_URL="MY_APP_URL"

# --- The four surfaces ---
# Each audience has its own hostname, and one server process answers all of
# them (it decides what to serve from req.hostname):
#
#   qulaycafe.uz          landing   — the marketing site in landing/
#   clients.qulaycafe.uz  clients   — guests: menu, cart, delivery, booking
#   kitchen.qulaycafe.uz  kitchen   — the kitchen display
#   admin.qulaycafe.uz    admin     — the restaurant dashboard
#
# Point all four DNS records at this server, and make sure the TLS
# certificate covers every hostname (a wildcard *.qulaycafe.uz plus the
# apex is the simplest).
#
# LANDING_HOSTNAMES / CLIENTS_HOSTNAMES: which hostnames map to which
# surface. Only needed if you don't use the <surface>.<domain> convention
# (a staging box, a per-restaurant custom domain, an ngrok tunnel).
LANDING_HOSTNAMES=qulaycafe.uz,www.qulaycafe.uz
CLIENTS_HOSTNAMES=clients.qulaycafe.uz

# Hostnames that served everything at once before the split. Table QR codes
# already printed, bookmarks and Telegram links out in the world still point
# here, so page requests to them are 301-redirected to the right surface
# (?view=admin / ?view=kitchen included). API calls and assets keep working
# on the old hostname so a tab that was open mid-order doesn't break.
LEGACY_APP_HOSTNAMES=app.qulaycafe.uz

# Absolute URLs used when the server has to *generate* a link for another
# surface: a QR code, a legacy redirect, the "order here" button in Telegram,
# the login link the owner bot hands to a new restaurant. Leave these blank
# and they are derived from APP_URL by swapping the leading label; set them
# explicitly if your surfaces don't share one parent domain.
CLIENTS_URL=https://clients.qulaycafe.uz
KITCHEN_URL=https://kitchen.qulaycafe.uz
ADMIN_URL=https://admin.qulaycafe.uz

# Frontend counterparts (VITE_* vars are compiled into the browser bundle at
# build time, so they must be set before `npm run build`, not at runtime).
# The bundle resolves its surface from window.location.hostname on its own;
# these are only needed for the same two reasons as above — non-standard
# hostnames, and generating cross-surface links (QR codes) from the admin UI.
VITE_LANDING_HOSTS=
VITE_CLIENTS_HOSTS=
VITE_KITCHEN_HOSTS=
VITE_ADMIN_HOSTS=
VITE_CLIENTS_URL=https://clients.qulaycafe.uz
VITE_KITCHEN_URL=https://kitchen.qulaycafe.uz
VITE_ADMIN_URL=https://admin.qulaycafe.uz

# Sales contact shown on the marketing page (qulaycafe.uz): its CTAs open
# Telegram or dial this number, because there is no self-service registration.
# Mirrors OWNER_CONTACT_* further down; blank falls back to those defaults
# compiled into src/landing/lib/links.ts.
VITE_CONTACT_TELEGRAM=your_telegram_username
VITE_CONTACT_PHONE=+998901234567

# Lets ?surface=admin|kitchen|clients force a surface in a production build.
# Keep this OFF (blank or false) on a real deployment: the entire point of the
# split is that a guest cannot reach the staff screens. It is always allowed
# on localhost and in `vite dev`, where all four surfaces share one origin.
VITE_ALLOW_SURFACE_OVERRIDE=

# Domain to scope the admin/kitchen session cookie to, so one login works
# across the staff subdomains. Note the leading dot:
#   SESSION_COOKIE_DOMAIN=.qulaycafe.uz
# Leave blank to scope the cookie to the exact hostname that issued it
# (correct for localhost, and for any deploy where admin and kitchen do not
# share a parent domain).
SESSION_COOKIE_DOMAIN=

# --- Server / security configuration (required outside AI Studio, e.g. on Hostinger/AWS) ---

NODE_ENV=production
PORT=3000

# Generate with: openssl rand -base64 48
# This signs admin/kitchen session cookies. Treat it like a password —
# never commit it, never share it, rotate it if it ever leaks.
JWT_SECRET=

# Bootstrap credentials, used ONLY the very first time the server starts
# (to create the initial hashed admin/kitchen accounts in the database).
# After first boot, change these from inside the admin dashboard's
# Security settings — editing these env vars again will NOT change an
# already-created account's password.
ADMIN_INITIAL_PASSWORD=
KITCHEN_INITIAL_PIN=

# Comma-separated list of exact origins allowed to call this API. With the
# surfaces split across subdomains, every one of them that talks to /api
# belongs in this list:
# ALLOWED_ORIGINS=https://clients.qulaycafe.uz,https://kitchen.qulaycafe.uz,https://admin.qulaycafe.uz
# (add https://app.qulaycafe.uz too while legacy links are still in the wild)
# Leave blank only for local development.
ALLOWED_ORIGINS=

# Where the persistent SQLite database file lives. Point this at a
# persistent volume/disk, not an ephemeral container filesystem.
DATABASE_DIR=./data

# How many days of completed orders to keep before automatic cleanup runs
# (once a day). Admin can also trigger cleanup manually, or delete
# individual orders, from the dashboard's Orders tab.
ORDER_RETENTION_DAYS=30

LOG_LEVEL=info

# --- Google Sign-In (optional but recommended) ---
# Get this from Google Cloud Console > APIs & Services > Credentials >
# Create Credentials > OAuth Client ID > Application type: Web application.
# Add every surface that shows a Google button under "Authorized JavaScript
# origins" — with the split that means https://clients.qulaycafe.uz (guests
# sign in there) and https://admin.qulaycafe.uz if you use it there too.
# This value is NOT secret — it's meant to
# be visible in the frontend — but it must be YOUR real one; the app refuses
# to fake a login if this is blank.
GOOGLE_CLIENT_ID=

# --- Telegram bot verification (optional) ---
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts.
# 2. Copy the token it gives you (looks like 123456789:ABC-...) into
#    TELEGRAM_BOT_TOKEN below. Treat it like a password.
# 3. Put the bot's @username (without the @) into TELEGRAM_BOT_USERNAME.
# 4. Generate a random secret for TELEGRAM_WEBHOOK_SECRET, e.g.:
#    openssl rand -hex 24
#    (this proves incoming webhook calls really came from Telegram, not
#    someone hitting your webhook URL directly to fake a verification)
# 5. Make sure APP_URL above is your real public https:// domain — the
#    server registers the webhook with Telegram automatically on startup.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# --- Multi-tenant / multi-restaurant configuration ---
# How many days a newly self-registered restaurant gets to try the system
# before Alex needs to activate/extend it.
DEFAULT_TRIAL_DAYS=14

# OFF by default: restaurants can only be onboarded by Alex through the
# owner bot (they contact him, pay, he creates their login). Set to "true"
# to also let restaurants sign themselves up from the login screen.
ENABLE_SELF_REGISTRATION=false

# Shown in the login modal's "yangi restoran ochish" screen when
# self-registration is off, so a restaurant knows how to reach Alex.
OWNER_CONTACT_PHONE=+998901234567
OWNER_CONTACT_TELEGRAM=your_telegram_username

# How many days before a subscription expires the owner bot starts
# warning Alex about it (also warns once if something expired in the last
# 24h and hasn't been suspended yet).
OWNER_EXPIRY_REMINDER_DAYS=3

# Protects the /api/owner/* endpoints (used by the owner bot and by Alex
# directly) — generate with: openssl rand -hex 24
OWNER_API_SECRET=

# --- Owner (super-admin) Telegram bot — separate bot from the customer
# verification bot above. This is how Alex creates restaurants and
# activates/suspends subscriptions after collecting payment manually
# (cash, Click, Payme, bank transfer — whatever). No payment gateway is
# wired into the app itself.
# 1. Message @BotFather, /newbot, get a token -> OWNER_BOT_TOKEN
# 2. Message @userinfobot (or similar) to get YOUR numeric Telegram user
#    ID -> OWNER_TELEGRAM_IDS (comma-separated if more than one person
#    should be able to manage this)
# 3. Generate a random secret: openssl rand -hex 24 -> OWNER_BOT_WEBHOOK_SECRET
OWNER_BOT_TOKEN=
OWNER_TELEGRAM_IDS=
OWNER_BOT_WEBHOOK_SECRET=

# --- Delivery bot — ONE shared bot used by every restaurant that has
# delivery enabled. Couriers link their own Telegram to their specific
# restaurant (scoped by restaurant_id, never mixed between restaurants).
# Alex turns delivery on/off per restaurant via the owner bot's
# /delivery_on and /delivery_off commands, or a restaurant can opt in at
# signup. Set up like the owner bot: new BotFather bot, separate from both
# the customer bot and the owner bot.
TELEGRAM_DELIVERY_BOT_TOKEN=
TELEGRAM_DELIVERY_BOT_USERNAME=
DELIVERY_BOT_WEBHOOK_SECRET=

