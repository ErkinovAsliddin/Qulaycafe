# Dependencies — rebuilt inside the image
node_modules

# Build outputs — the builder stage creates these from source.
# A stale host copy would shadow the fresh build.
dist
landing

# The design-export zip — not an input to any build step
Land

# Git metadata
.git
.gitignore

# Live database and WAL/SHM sidecar files.
# The database is bind-mounted at runtime; baking it into the
# image would be both insecure and wrong.
data
*.db
*.db-wal
*.db-shm

# Logs
*.log
npm-debug.log*

# Secrets — must never be baked into an image layer.
# Runtime env is injected via `env_file: .env` in compose;
# build-time VITE_* vars come in through `build: args:`.
.env
.env.local
.env.*.local
